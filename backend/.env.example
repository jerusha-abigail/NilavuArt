# Leave OPENAI_API_KEY unset to use OpenCV-only feedback.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional in local development; required for permanent hosted image storage.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Supabase Auth. Leave unset for local demo mode.
AUTH_REQUIRED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
